<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShadowsocksR_winui3.Views.ResetPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ResetPassword">

    <StackPanel Margin="16" Spacing="8" Width="360">
        <PasswordBox x:Name="OldPasswordBox" PlaceholderText="Old password" KeyDown="OldPasswordBox_KeyDown" />
        <PasswordBox x:Name="NewPasswordBox" PlaceholderText="New password" KeyDown="NewPasswordBox_KeyDown" />
        <PasswordBox x:Name="NewPasswordBox2" PlaceholderText="New password (again)" KeyDown="NewPasswordBox2_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" Click="OkButton_Click" />
            <Button Content="Cancel" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
