<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShadowsocksR_winui3.Views.InputPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="InputPassword">

    <StackPanel Margin="16" Spacing="8" Width="360">
        <TextBlock x:Name="InfoText"
                   Text="Parse gui-config.json error, maybe require password to decrypt"
                   TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" Click="OkButton_Click" />
            <Button Content="Cancel" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
