<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShadowsocksR_winui3.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="12" ColumnSpacing="12" RowSpacing="8" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="ProjectUrlLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" />
        <HyperlinkButton x:Name="ProjectUrlLink" Grid.Row="1" Grid.Column="1" Padding="0"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         NavigateUri="https://github.com/liangzhaoyuan12/ShadowsocksR-winui3"
                         Content="https://github.com/liangzhaoyuan12/ShadowsocksR-winui3" />

        <TextBlock x:Name="LicenseLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="LicenseValue" Grid.Row="2" Grid.Column="1" Text="GPL-v3" VerticalAlignment="Center" />

        <TextBlock x:Name="DeveloperLabel" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="DeveloperValue" Grid.Row="3" Grid.Column="1" Text="liangzhaoyuan12" VerticalAlignment="Center" />
    </Grid>
</Page>
