<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShadowsocksR_winui3.Views.ServerLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Key="GridMenu">
            <MenuFlyoutItem Tag="&amp;Disconnect direct connections" Click="MenuItem_Click" />
            <MenuFlyoutItem Tag="Disconnect &amp;All" Click="MenuItem_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Tag="Clear &amp;MaxSpeed" Click="MenuItem_Click" />
            <MenuFlyoutItem Tag="&amp;Clear" Click="MenuItem_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Tag="Clear &amp;Selected Total" Click="MenuItem_Click" />
            <MenuFlyoutItem Tag="Clear &amp;Total" Click="MenuItem_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Tag="Copy current link" Click="MenuItem_Click" />
            <MenuFlyoutItem Tag="Copy current group links" Click="MenuItem_Click" />
            <MenuFlyoutItem Tag="Copy all enable links" Click="MenuItem_Click" />
            <MenuFlyoutItem Tag="Copy all links" Click="MenuItem_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Tag="Auto &amp;size" Click="MenuItem_Click" />
            <ToggleMenuFlyoutItem Tag="Always On &amp;Top" Click="MenuItem_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="RootGrid" Margin="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="ServerLog" />

        <CommandBar x:Name="MenuBar" Grid.Row="1">
            <AppBarButton x:Name="ControlMenuButton" Label="Control">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Tag="&amp;Disconnect direct connections" Click="MenuItem_Click" />
                        <MenuFlyoutItem Tag="Disconnect &amp;All" Click="MenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Tag="Clear &amp;MaxSpeed" Click="MenuItem_Click" />
                        <MenuFlyoutItem Tag="&amp;Clear" Click="MenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Tag="Clear &amp;Selected Total" Click="MenuItem_Click" />
                        <MenuFlyoutItem Tag="Clear &amp;Total" Click="MenuItem_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="PortOutMenuButton" Label="Port out">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Tag="Copy current link" Click="MenuItem_Click" />
                        <MenuFlyoutItem Tag="Copy current group links" Click="MenuItem_Click" />
                        <MenuFlyoutItem Tag="Copy all enable links" Click="MenuItem_Click" />
                        <MenuFlyoutItem Tag="Copy all links" Click="MenuItem_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="WindowMenuButton" Label="Window">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Tag="Auto &amp;size" Click="MenuItem_Click" />
                        <ToggleMenuFlyoutItem Tag="Always On &amp;Top" Click="MenuItem_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <controls:DataGrid x:Name="ServerDataGrid" Grid.Row="2"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           SelectionMode="Single"
                           CanUserSortColumns="False"
                           HeadersVisibility="Column"
                           GridLinesVisibility="All"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           RequestedTheme="Light"
                           LoadingRow="ServerDataGrid_LoadingRow"
                           UnloadingRow="ServerDataGrid_UnloadingRow">
            <controls:DataGrid.Columns>
                <controls:DataGridTemplateColumn Header="ID" Width="36" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgID}" Padding="6,0">
                                <TextBlock Text="{Binding ID}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Group" Width="60">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgGroup}" Padding="6,0">
                                <TextBlock Text="{Binding Group}" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Server" Width="88" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgServer}" Padding="6,0">
                                <TextBlock Text="{Binding Server}" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Enable" Width="24" MinWidth="8">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgEnable}" Padding="0">
                                <TextBlock Text="{Binding Enable}" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Total Connect" Width="48" MinWidth="2" Visibility="Collapsed">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgTotalConnect}" Padding="6,0">
                                <TextBlock Text="{Binding TotalConnect}" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Connecting" Width="28" MinWidth="16">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgConnecting}" Padding="4,0">
                                <TextBlock Text="{Binding Connecting}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Latency" Width="48" MinWidth="36">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgAvgLatency}" Padding="4,0">
                                <TextBlock Text="{Binding AvgLatency}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Avg DSpeed" Width="60" MinWidth="60">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgAvgDownSpeed}" Padding="4,0">
                                <TextBlock Text="{Binding AvgDownSpeed}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Max DSpeed" Width="60" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgMaxDownSpeed}" Padding="4,0">
                                <TextBlock Text="{Binding MaxDownSpeed}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Avg UpSpeed" Width="60" MinWidth="60">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgAvgUpSpeed}" Padding="4,0">
                                <TextBlock Text="{Binding AvgUpSpeed}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Max UpSpeed" Width="60" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgMaxUpSpeed}" Padding="4,0">
                                <TextBlock Text="{Binding MaxUpSpeed}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Dload" Width="60" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgDownload}" ToolTipService.ToolTip="{Binding TipDownload}" Padding="4,0">
                                <TextBlock Text="{Binding Download}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Upload" Width="60" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgUpload}" ToolTipService.ToolTip="{Binding TipUpload}" Padding="4,0">
                                <TextBlock Text="{Binding Upload}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="DloadRaw" Width="60" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgDownloadRaw}" ToolTipService.ToolTip="{Binding TipDownloadRaw}" Padding="4,0">
                                <TextBlock Text="{Binding DownloadRaw}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Error Percent" Width="48" MinWidth="2" Visibility="Collapsed">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgErrorPercent}" Padding="4,0">
                                <TextBlock Text="{Binding ErrorPercent}" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Error" Width="28" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgConnectError}" Padding="4,0">
                                <TextBlock Text="{Binding ConnectError}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Timeout" Width="28" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgConnectTimeout}" Padding="4,0">
                                <TextBlock Text="{Binding ConnectTimeout}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Empty Response" Width="28" MinWidth="2">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgConnectEmpty}" Padding="4,0">
                                <TextBlock Text="{Binding ConnectEmpty}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="Continuous" Width="28" Visibility="Collapsed">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BgContinuous}" Padding="4,0">
                                <TextBlock Text="{Binding Continuous}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</Page>
