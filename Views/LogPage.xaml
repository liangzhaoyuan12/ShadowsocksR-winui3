<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShadowsocksR_winui3.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar x:Name="logMenu" Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton x:Name="fileToolStripMenuItem" Label="File">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="clearLogToolStripMenuItem" Text="Clear log" Click="clearLogToolStripMenuItem_Click" />
                        <MenuFlyoutItem x:Name="showInExplorerToolStripMenuItem" Text="Show in Explorer" Click="showInExplorerToolStripMenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="closeToolStripMenuItem" Text="Close" Click="closeToolStripMenuItem_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarToggleButton x:Name="wrapTextToolStripMenuItem" Label="Wrap Text"
                                Checked="wrapTextToolStripMenuItem_Changed" Unchecked="wrapTextToolStripMenuItem_Changed" />
            <AppBarToggleButton x:Name="alwaysOnTopToolStripMenuItem" Label="Always on top"
                                Checked="alwaysOnTopToolStripMenuItem_Changed" Unchecked="alwaysOnTopToolStripMenuItem_Changed" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" Text="Log Viewer" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="fontToolStripMenuItem" Text="Font" VerticalAlignment="Center" />
                <ComboBox x:Name="FontFamilyCombo" MinWidth="140" SelectionChanged="FontFamilyCombo_SelectionChanged" />
                <ComboBox x:Name="FontSizeCombo" MinWidth="80" SelectionChanged="FontSizeCombo_SelectionChanged" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="logTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="NoWrap" FontFamily="Courier New" FontSize="14" FontWeight="Bold"
                 Foreground="White" Background="Black" MaxLength="2147483647" />
    </Grid>
</Page>
