<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShadowsocksR_winui3.Views.PortMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="12" ColumnSpacing="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <ListBox x:Name="listPorts" Grid.Row="1" Grid.Column="0" SelectionMode="Single" FontFamily="Consolas"
                 SelectionChanged="listPorts_SelectionChanged" />

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border x:Name="groupBox1" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="groupBox1Title" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="checkEnable" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" />

                        <TextBlock x:Name="labelType" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                   TextAlignment="Right" />
                        <ComboBox x:Name="comboBoxType" Grid.Row="1" Grid.Column="1"
                                  SelectionChanged="comboBoxType_SelectedIndexChanged" />

                        <TextBlock x:Name="labelID" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                   TextAlignment="Right" />
                        <ComboBox x:Name="comboServers" Grid.Row="2" Grid.Column="1" />

                        <TextBlock x:Name="labelLocal" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                                   TextAlignment="Right" />
                        <NumberBox x:Name="NumLocalPort" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="65535"
                                   SpinButtonPlacementMode="Inline" />

                        <TextBlock x:Name="labelAddr" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                                   TextAlignment="Right" />
                        <TextBox x:Name="textAddr" Grid.Row="4" Grid.Column="1" />

                        <TextBlock x:Name="labelPort" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"
                                   TextAlignment="Right" />
                        <NumberBox x:Name="NumTargetPort" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="65535"
                                   SpinButtonPlacementMode="Inline" />

                        <TextBlock x:Name="label1" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                                   TextAlignment="Right" />
                        <TextBox x:Name="textRemarks" Grid.Row="6" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button x:Name="Add" Click="Add_Click" />
            <Button x:Name="Del" Click="Del_Click" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="OKButton" Click="OKButton_Click" />
            <Button x:Name="MyCancelButton" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Page>
